VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/VOTRE_ID
VITE_TESTIMONIAL_FORM_ENDPOINT=https://formspree.io/f/VOTRE_ID
# Livre d'or : URL de la fonction serverless qui crée le témoignage dans
# Sanity (frontend/api/submit-testimonial.js). Non renseignée → Formspree.
VITE_TESTIMONIAL_API_ENDPOINT=

# Outil de statistiques Neotisse. Activer après vérification du serveur.
VITE_ANALYTICS_ENABLED=false
# Variables SERVEUR uniquement (à configurer sur Vercel, jamais VITE_).
# ANALYTICS_ENABLED=true
# ANALYTICS_ALLOWED_ORIGINS=https://neotisse.vercel.app
# SANITY_ANALYTICS_WRITE_TOKEN= (ou SANITY_WRITE_TOKEN existant)
# CRON_SECRET= (secret aléatoire pour la purge quotidienne)
